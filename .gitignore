/yolov11spose/

# Keep only the original ONNX model and accompanying metadata for each selected model.
/yolo11n-hand-pose/*
!/yolo11n-hand-pose/data.yaml
!/yolo11n-hand-pose/yolo11n-hand-pose.onnx

/yolov8n-hand-pose_512x288_split/*
!/yolov8n-hand-pose_512x288_split/hand-keypoints.yaml
!/yolov8n-hand-pose_512x288_split/pose_split_kps.py
!/yolov8n-hand-pose_512x288_split/yolov8n-hand-pose.onnx

/yolov8s-hand-pose_512x288_split/*
!/yolov8s-hand-pose_512x288_split/hand-keypoints-identity-flip.yaml
!/yolov8s-hand-pose_512x288_split/hand-keypoints-identity-flip-hagrid.yaml
!/yolov8s-hand-pose_512x288_split/pose_split_kps.py
!/yolov8s-hand-pose_512x288_split/yolov8s-hand-pose.pt
!/yolov8s-hand-pose_512x288_split/yolov8s-hand-pose.onnx
!/yolov8s-hand-pose_512x288_split/yolov8s-hand-pose_cut.onnx
!/yolov8s-hand-pose_512x288_split/yolov8s-hand-pose_edit.onnx

# Laptop-only training (heat throttling, local runs). Keep ignored even if the
# whitelist above is widened later.
/yolov8s-hand-pose_512x288_split/train_laptop.py
/yolov8s-hand-pose_512x288_split/train_laptop.sh
/yolov8s-hand-pose_512x288_split/train_laptop.*
/yolov8s-hand-pose_512x288_split/train_identity/
/yolov8s-hand-pose_512x288_split/train.sh
/yolov8s-hand-pose_512x288_split/resume.sh
/yolov8s-hand-pose_512x288_split/ultralytics_config/
